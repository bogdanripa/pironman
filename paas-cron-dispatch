#!/usr/bin/env python3
"""Host-side cron dispatcher. One crontab entry runs this every minute:

    * * * * * /usr/local/bin/paas-cron-dispatch >> /var/log/paas-cron.log 2>&1

Reads the crons table straight out of Postgres via `docker exec`, so the host
needs no Python database driver — only the stdlib.

Calls each due job at the app's PUBLIC url, deliberately: once Sablier is in
place, a cron hitting a slept app wakes it.
"""
import json
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone

sys.path.insert(0, "/opt/paas")          # where app/cronmatch.py is mounted
from app.cronmatch import due            # noqa: E402

DOMAIN_SUFFIX = "-coolify.bogdanripa.com"
# Joined to apps, not read from crons alone. A cron row can outlive its app —
# anything that removes an app without clearing its jobs leaves one behind — and
# an orphan fires every minute for ever at a hostname that routes nowhere. The
# join makes the app's existence the condition for firing, so a stale row is
# inert rather than a permanent source of traffic and 5xx.
SQL = ("SELECT coalesce(json_agg(json_build_object("
       "'app_id', c.app_id, 'schedule', c.schedule, 'method', c.method, "
       "'path', c.path, 'body', c.body))::text, '[]') "
       "FROM crons c JOIN apps a ON a.id = c.app_id WHERE c.enabled")


def pg_container() -> str:
    """The container holding the control plane's `_paas` database.

    NOT simply the first `postgres:` image. Once any app has its own Postgres
    there is more than one candidate, `docker ps` lists newest first, and a
    freshly provisioned app database quietly becomes the answer — `psql` then
    exits 2 against a `_paas` that does not exist there, this script dies, and
    every scheduled job on the box silently stops firing. That is not
    hypothetical: it is how the dispatcher broke.

    So probe for the database instead of guessing from the image tag. A wrong
    guess is indistinguishable from a healthy run here, because a minute with no
    due job prints nothing either way.
    """
    out = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}\t{{.Image}}"],
        capture_output=True, text=True, check=True).stdout
    candidates = [
        name for name, _, image in (l.partition("\t") for l in out.splitlines())
        if image.startswith("postgres:") and name != "coolify-db"
    ]
    for name in candidates:
        probe = subprocess.run(
            ["docker", "exec", "-i", name,
             "psql", "-U", "postgres", "-d", "_paas", "-tAc", "SELECT 1"],
            capture_output=True, text=True)
        if probe.returncode == 0:
            return name
    raise SystemExit(
        f"no postgres container has a _paas database (tried: {candidates or 'none'})")


def rows(container: str) -> list[dict]:
    r = subprocess.run(
        ["docker", "exec", "-i", container,
         "psql", "-U", "postgres", "-d", "_paas", "-tAc", SQL],
        capture_output=True, text=True, check=True)
    return json.loads(r.stdout.strip() or "[]")


def fire(app_id: str, method: str, path: str, body: str) -> None:
    # Hit Traefik directly rather than going out to Cloudflare and back:
    # same router, same middleware chain (so Sablier still wakes the app),
    # but no egress, no bot rules, and it survives the tunnel being down.
    host = f"{app_id}{DOMAIN_SUFFIX}"
    url = f"http://127.0.0.1{path}"
    data = body.encode() if body else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Host", host)
    req.add_header("User-Agent", "paas-cron/1.0")
    if data:
        req.add_header("Content-Type", "application/json")
    stamp = datetime.now(timezone.utc).isoformat(timespec="seconds")
    try:
        with urllib.request.urlopen(req, timeout=300) as resp:
            print(f"{stamp} {method} {host}{path} -> {resp.status}")
    except Exception as e:                                  # noqa: BLE001
        print(f"{stamp} {method} {host}{path} -> ERROR {e}")


def beat(container: str) -> None:
    """Record that a dispatch pass completed, for the platform's liveness table.

    This script is silent when nothing is due, which is most minutes — so its own
    log cannot distinguish "ran, nothing scheduled" from "has not run since the
    crontab entry was removed" or "dies every minute on an error". A beat makes
    the difference visible to anything reading the database, without this having
    to become chatty.
    """
    try:
        subprocess.run(
            ["docker", "exec", "-i", container, "psql", "-U", "postgres",
             "-d", "_paas", "-tAc",
             "INSERT INTO task_heartbeat (task, last_ok, stale_after_s) "
             "VALUES ('cron_dispatch', now(), 300) "
             "ON CONFLICT (task) DO UPDATE SET last_ok = now(), "
             "last_error = NULL, last_error_at = NULL"],
            capture_output=True, text=True, check=True)
    except Exception as e:                                      # noqa: BLE001
        # Bookkeeping must never stop jobs from firing.
        print(f"warning: could not record heartbeat: {e}")


def main() -> None:
    now = datetime.now()
    container = pg_container()
    for c in rows(container):
        if due(c["schedule"], now):
            fire(c["app_id"], c["method"], c["path"], c["body"] or "")
    beat(container)


if __name__ == "__main__":
    main()
