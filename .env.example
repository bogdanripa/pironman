# Coolify facade
COOLIFY_URL=http://coolify:8000
COOLIFY_TOKEN=changeme
COOLIFY_PROJECT=pn6ktl8mfvt6358ajw5vvtiq
COOLIFY_SERVER=nz34jwbofpzj5if67kgdcjb3
COOLIFY_DESTINATION=u9boqoi8bow5n50f1te9knul
COOLIFY_ENV_NAME=production

# Where apps live
DOMAIN_SUFFIX=-coolify.bogdanripa.com

# Analytics: the edge-proxy container whose access log is tailed for visitor
# stats, and the salt keying the cookieless visitor hash. Defaults are fine;
# keep ANALYTICS_SALT stable (changing it makes past visitors count as new).
ANALYTICS_PROXY=coolify-proxy
ANALYTICS_SALT=pironman-analytics-v1

# Telegram alerts (optional). Set both to get a message when an app goes down,
# recovers, or throws new 5xx errors. Token from @BotFather; chat id is the
# destination chat/DM. ALERT_5XX_THRESHOLD = new 5xx per check before alerting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_5XX_THRESHOLD=5

# Cloudflare cache purge on frontend deploys (optional). Token needs only
# Zone.Cache Purge on this zone. Without these, published bundles are correct but
# unhashed assets stay cached at the edge until their TTL expires.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Sablier scale-to-zero. SABLIER_URL is how Traefik reaches the Sablier container
# (verify against your proxy network). SABLIER_EXCLUDE never sleeps (the control
# plane). Set SABLIER_AUTO_ENROLL=true only after verifying enrollment on one app
# with apps_sablier — until then, new/updated apps are not auto-enrolled.
SABLIER_URL=http://sablier:10000
SABLIER_SESSION_DURATION=5m
SABLIER_STRATEGY=blocking
SABLIER_BLOCKING_TIMEOUT=60s
SABLIER_EXCLUDE=api
SABLIER_AUTO_ENROLL=false

# ghcr read credential for auto-update digest checks (docker pull of private
# images). GITHUB_TOKEN (for the github_secret_* tools) falls back to GHCR_TOKEN;
# set it separately if the secrets tools need `repo` scope the pull token lacks.
GHCR_USER=
GHCR_TOKEN=
GITHUB_TOKEN=

# host_run_script: image the throwaway nsenter helper runs. Leave unset — it
# then uses paas-api's own image, which is already on the box. Only set this if
# that image ever stops shipping nsenter (any image with it works, e.g. alpine).
HOST_EXEC_IMAGE=

# Registry database (_paas) — from `pdb create _paas`
PAAS_DB_HOST=
PAAS_DB_PORT=5432
PAAS_DB_USER=_paas
PAAS_DB_PASSWORD=
PAAS_DB_NAME=_paas
